# ─────────────────────────────────────────────────────────────────────────────
# Sainand Chits India: production settings (copy to .env on the server)
#   cp deploy/env.production.example .env   then fill in every value marked <...>
#   Check it with:   node services/config-check.js
# Never commit .env or send it to anyone. Keep a copy in a password manager.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5001
# Only nginx talks to the app; the app is not reachable from the internet directly.
HOST=127.0.0.1
PUBLIC_SITE_URL=https://sainandchits.com

# Database (local PostgreSQL on the same server)
DATABASE_URL=postgresql://sainand_app:<db-password>@127.0.0.1:5432/sainand
DB_POOL_MAX=10

# Make this with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<96 random characters>

# Admin sign-in: at least 12 characters with letters and numbers, different from each other.
ADMIN_USERNAME=rohan.kamble
ADMIN_PASSWORD=<strong password>
SYSTEM_ADMIN_PASSWORD=<different strong password>
ADMIN_EMAIL=<your business email>
# Sign out admin users after this many minutes without activity.
ADMIN_IDLE_MINUTES=30

# Company details shown on the website and in emails
COMPANY_NAME=Sainand Chits India
COMPANY_PHONE=+91 92724 60719
COMPANY_EMAIL=support@sainandchits.com

# Email (business mailbox on your domain, e.g. Zoho Mail / Google Workspace)
SMTP_HOST=<smtp.zoho.in or smtp.gmail.com>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@sainandchits.com
SMTP_PASS=<app password from the mail provider>
SMTP_FROM=Sainand Chits India <support@sainandchits.com>
NOTIFICATION_EMAIL=<who gets new enquiry emails>
LEADS_NOTIFICATION_EMAIL=<same or sales team address>
CAREERS_NOTIFICATION_EMAIL=<who gets job applications>

# Daily summary email to managers (true/false)
DAILY_DIGEST=on

# Sai chat assistant (optional; without it Sai answers from FAQs only)
GROQ_API_KEY=<key from console.groq.com>

# Cloudflare Turnstile security check on all forms (replaces the "quick check" sum).
# Get both keys free at dash.cloudflare.com → Turnstile → Add site (sainandchits.com, mode: Managed).
TURNSTILE_SITE_KEY=<site key>
TURNSTILE_SECRET_KEY=<secret key>
